import streamlit as st
import pandas as pd
import joblib

# 1. إعدادات الصفحة
st.set_page_config(
    page_title="توقع أسعار السيارات في مصر",
    page_icon="🚗",
    layout="centered"
)

# 2. تحميل الـ Pipeline المدرب مسبقاً
@st.cache_resource
def load_model():
    # تأكدي إن اسم الملف مطابق للي طلعتيه
    return joblib.load('car_price_pipeline.pkl')

pipeline = load_model()

st.title("🚗 نظام توقع أسعار السيارات في السوق المصري")
st.write("أدخل تفاصيل السيارة لمعرفة السعر المحدد ورينج الأسعار المتوقع بالجنيه المصري (EGP).")

st.markdown("---")

# 3. تصميم مدخلات المستخدم (Inputs) متوافقة مع الـ Features بتاعتك
col1, col2 = st.columns(2)

with col1:
    year = st.slider("سنة الصنع (Year)", min_value=2010, max_value=2026, value=2020)
    km_driven = st.number_input("العداد (الكيلومترات المقطوعة - KM_Driven)", min_value=0, max_value=500000, value=50000, step=5000)

with col2:
    fuel_type = st.selectbox("نوع الوقود (Fuel_Type)", ["Petrol", "Diesel"])
    transmission = st.selectbox("ناقل الحركة (Transmission)", ["Automatic", "Manual"])

st.markdown("---")

# 4. زر التوقع ومعالجة البيانات
if st.button("توقع السعر الآن 🔍", use_container_width=True):
    
    # تجهيز المدخلات في DataFrame بنفس أسماء الأعمدة المستخدمة أثناء التدريب
    input_data = pd.DataFrame({
        'Year': [year],
        'KM_Driven': [km_driven],
        'Fuel_Type': [fuel_type],
        'Transmission': [transmission]
    })
    
    try:
        # الـ Pipeline هيقوم بعمل الـ Encoding والتوقع تلقائياً!
        predicted_price = pipeline.predict(input_data)[0]
        
        # حساب رينج السعر (بفرق 7% كمثال تقريبي لتباين السوق)
        margin = predicted_price * 0.07
        min_price = max(0, predicted_price - margin)
        max_price = predicted_price + margin
        
        # عرض النتائج
        st.success("تم التوقع بنجاح!")
        
        metric_col1, metric_col2 = st.columns(2)
        with metric_col1:
            st.metric(label="🏷️ السعر المتوقع المحدّد", value=f"{int(predicted_price):,} جنيه")
        with metric_col2:
            st.metric(label="📊 رينج الأسعار المتوقع", value=f"{int(min_price):,} - {int(max_price):,} جنيه")
            
        st.info("⚠️ ملحوظة: هذا التوقع استرشادي بناءً على الأسعار الحالية في السوق المصري وقد يختلف حسب حالة السيارة الفعلية.")
        
    except Exception as e:
        st.error(f"حدث خطأ أثناء عملية التوقع: {e}")
